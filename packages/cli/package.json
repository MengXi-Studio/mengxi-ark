{
	"name": "@mengxi-ark/cli",
	"version": "1.0.0-beta.1",
	"description": "曦舟 MengXi Ark 脚手架：pnpm create mengxi-ark",
	"license": "MIT",
	"type": "module",
	"bin": {
		"create-mengxi-ark": "./bin/create-mengxi-ark.js"
	},
	"files": [
		"dist",
		"bin",
		"templates"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0"
	},
	"devDependencies": {
		"@mengxi-ark-internal/build-scripts": "workspace:*",
		"@types/node": "^26.6.7",
		"typescript": "^5.9.3",
		"vitest": "^5.1.1"
	}
}
